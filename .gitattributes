# Phase 0.2 evidence is hashed byte-for-byte; preserve it on every platform.
/.gitattributes text eol=lf
/artifacts/direction_a/phase0_2_v1/** -text
# The saved Windows ledger has CRLF; recognize CR as a line terminator.
/artifacts/direction_a/phase0_2_v1/run.json whitespace=cr-at-eol
/direction_a/*.py text eol=lf
/scripts/accept_direction_a_baseline.py text eol=lf
/tests/test_direction_a_baseline.py text eol=lf
/docs/DIRECTION_A_0_2_*.md text eol=lf
# G1.1 event evidence has its own byte-preserving scope.
/artifacts/direction_a/phaseG1_1_v1/** -text
/scripts/accept_direction_a_event_support.py text eol=lf
/tests/test_direction_a_event_support.py text eol=lf
/docs/DIRECTION_A_G1_1_*.md text eol=lf
# Backbone preparation candidates keep their exact archived bytes.
/artifacts/direction_a/backbone_preparation_v1/** -text
/scripts/prepare_direction_a_backbones.py text eol=lf
/tests/test_direction_a_backbone_preparation.py text eol=lf
/docs/DIRECTION_A_BACKBONE_PREPARATION_RUN_RECORD_v1.md text eol=lf
/docs/DIRECTION_A_BACKBONE_PREPARATION_HANDOFF_v1.md text eol=lf
# G1.2 first-segment smoke preserves measured evidence bytes.
/artifacts/direction_a/phaseG1_2_smoke_v1/** -text
/scripts/measure_direction_a_class_gradient_smoke.py text eol=lf
/tests/test_direction_a_class_gradient_smoke.py text eol=lf
/docs/DIRECTION_A_G1_2_SMOKE_*.md text eol=lf
# A-prime text and evidence use explicit, independent scopes.
/docs/projects/a_prime/*.md text eol=lf
/docs/projects/a_prime/*.json text eol=lf
/scripts/check_a_prime_startup.py text eol=lf
/scripts/check_a_prime_e01.py text eol=lf
/scripts/run_a_prime_e01.ps1 text eol=lf
/artifacts/a_prime/** -text
# Preserve Windows receipts and the intentionally incomplete serializer output byte-for-byte.
/artifacts/a_prime/e01/*.json whitespace=cr-at-eol
/artifacts/a_prime/e01/results_attempt_01.partial.txt whitespace=-blank-at-eol
# E02 sources are stable text; Windows outer receipts remain byte-preserved evidence.
/scripts/check_a_prime_e02.py text eol=lf
/scripts/a_prime_e02_events.py text eol=lf
/scripts/run_a_prime_e02.ps1 text eol=lf
/artifacts/a_prime/e02/*.json whitespace=cr-at-eol
